# Git and editor metadata
.git
.gitignore
.vscode
.idea

# Dependencies (the image installs its own)
node_modules
**/node_modules

# Build artifacts and generated code (the image builds and generates its own: a stale copy must not win)
**/dist
**/build
**/coverage
server/src/generated
frontend/src/routeTree.gen.ts

# Environment files: never in an image, wherever they are (a pattern without **/ only matches the root)
**/.env
**/.env.*
!**/.env.example
!**/.env.test.example
!**/.env.production.example

# Notes and docs (not needed to build or run)
*.md
CLAUDE_SANDBOX_NOTES.md

# Logs and caches
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Docker files
Dockerfile
docker-compose*.yml
**/docker-compose*.yml
