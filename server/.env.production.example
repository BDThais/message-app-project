# Every setting of the server in production. Copy to server/.env.production (never commit it) for
# `docker run --env-file`, or enter the values in your host's dashboard (render.yaml lists the ones Render asks for).
# What each one does, and how to choose it: deployment.doc.md. Settings that are not listed have good defaults.

NODE_ENV=production

# The database. With Neon (free): its DIRECT connection string, the one whose host has no "-pooler", as Neon shows it
# (it ends in ?sslmode=require&channel_binding=require; the driver prints a harmless warning about "sslmode").
# With a Render database: its internal connection string, which render.yaml fills in for a paid setup.
DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# true: apply the pending migrations when the container starts (scripts/docker-start.sh). For hosts with no step to run
# before a deploy goes live, such as Render's free plan; safe because exactly one instance runs. Leave it unset where the
# host runs `npx prisma migrate deploy` itself first (a paid Render service's preDeployCommand).
MIGRATE_ON_START=true

# The address the app is opened at: scheme and host (and port if not the default), no path, no trailing slash.
# A socket from a page on any other origin is refused. Must be https.
APP_ORIGIN=https://chat.example.com

# How many reverse proxies stand between the browser and the server. REQUIRED. 1 on Render, Railway and Fly;
# 0 when the server takes connections directly. A wrong number breaks the rate limits: see "Finding the right
# TRUST_PROXY" in deployment.doc.md, and use LOG_CLIENT_IP=true for the first requests to check.
TRUST_PROXY=1
# LOG_CLIENT_IP=true

# The pages the mailed links open (the token is added as #token=...).
EMAIL_VERIFICATION_URL=https://chat.example.com/verify-email
PASSWORD_RESET_URL=https://chat.example.com/reset-password

# Mail. The console transport only logs, so production needs Resend. A sender on a domain verified in Resend can mail
# anyone. Without a domain, use MAIL_FROM=Message App <onboarding@resend.dev>: Resend then delivers only to the address
# the Resend account was made with, so other people's accounts have to be made with src/scripts/createVerifiedUser.ts.
MAIL_TRANSPORT=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Message App <no-reply@chat.example.com>

# Whether anybody may sign up. false when the deployment cannot mail strangers a verification link (no verified mail domain):
# POST /api/account/signup then answers 403, and accounts are made by hand with src/scripts/createVerifiedUser.ts.
SIGNUP_ENABLED=true

# The session cookie's name. With the __Host- prefix a browser only accepts it over https, for exactly this host.
SESSION_COOKIE=__Host-session

# Set by the Docker image: the folder of the built frontend, which the server then serves.
# FRONTEND_DIST=/app/frontend-dist

# Optional, with defaults: PORT=3000, SESSION_TTL_MS=604800000 (7 days), EMAIL_VERIFICATION_TTL_MS=86400000 (24 h),
# PASSWORD_RESET_TTL_MS=1800000 (30 min), EMPTY_ROOM_RETENTION_MS=604800000 (7 days), EMPTY_ROOM_CLEANUP_INTERVAL_MS=3600000 (1 h).
