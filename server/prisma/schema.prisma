generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ChatRoomType {
  direct
  group
}

enum ChatMemberRole {
  admin
  member
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  tel          String   @unique
  avatarUrl    String?  @map("avatar_url")
  emailVerifiedAt DateTime? @map("email_verified_at")

  sessions               Session[]
  emailVerificationToken EmailVerificationToken?
  chatMemberships        ChatMember[]
  sentMessages            Message[]
  sentFriendRequests     PendingFriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests PendingFriendRequest[] @relation("ReceivedFriendRequests")
  friendListEntries      FriendListMember[]     @relation("FriendListOwner")
  friendOfLists          FriendListMember[]     @relation("FriendListFriend")

  @@map("users")
}

model Session {
  id        String   @id
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// The emailed link that proves an address. At most one per user (the user id is
// the primary key), so asking again replaces the old link. Only the SHA-256 of
// the token is stored. `email` is the address the link was issued for, which
// is what lets the same row also confirm a change of address later: confirming
// applies the row's `email` to the user.
model EmailVerificationToken {
  userId    Int      @id @map("user_id")
  email     String
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model ChatRoom {
  id   Int          @id @default(autoincrement())
  name String?
  type ChatRoomType
  avatarUrl String?      @map("avatar_url")
  createdAt DateTime     @default(now()) @map("created_at")
  // Set when the last member leaves; the cleanup job deletes the room (and,
  // by cascade, its messages) once it has stayed empty for the retention period.
  emptiedAt DateTime?    @map("emptied_at")

  members  ChatMember[]
  messages Message[]

  @@index([emptiedAt])
  @@map("chat_rooms")
}

model ChatMember {
  memberId          Int  @map("member_id")
  chatId            Int  @map("chat_id")
  role              ChatMemberRole @default(member)
  lastReadMessageId Int? @map("last_read_message_id")

  member          User     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  chatRoom        ChatRoom @relation(fields: [chatId], references: [id], onDelete: Cascade)
  lastReadMessage Message? @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@id([memberId, chatId])
  @@index([chatId])
  @@map("chat_members")
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int      @map("chat_id")
  senderId  Int?     @map("sender_id")
  createdAt DateTime @default(now()) @map("created_at")
  content   String
  deletedAt DateTime? @map("deleted_at")
  editedAt  DateTime? @map("edited_at")

  chatRoom   ChatRoom     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  lastReadBy ChatMember[]

  @@index([chatId, id])
  @@map("messages")
}

model PendingFriendRequest {
  id         Int      @id @default(autoincrement())
  senderId   Int      @map("sender_id")
  receiverId Int      @map("receiver_id")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@map("pending_friend_requests")
}

model FriendListMember {
  userId   Int @map("user_id")
  friendId Int @map("friend_id")

  user   User @relation("FriendListOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendListFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@map("friend_list_members")
}
