{
  "name": "server",
  "version": "1.0.0",
  "description": "Server for the message app",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/fix-esm-imports.mjs",
    "start": "node dist/server.js",
    "test": "npm run db:test:up && npm run db:test:deploy && vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "db:test:up": "node scripts/test-db.mjs up",
    "db:test:down": "node scripts/test-db.mjs down",
    "db:test:deploy": "node scripts/test-db.mjs deploy",
    "db:test:reset": "node scripts/test-db.mjs reset"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "libphonenumber-js": "^1.13.10",
    "pg": "^8.22.0",
    "validator": "^13.15.35"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "argon2@0.45.1": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  },
  "overrides": {
  "deepmerge-ts": "^8.0.0"
  }
}
